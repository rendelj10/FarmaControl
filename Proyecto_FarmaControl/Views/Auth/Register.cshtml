@model Proyecto_FarmaControl.DTOs.RegisterRequestDto

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-page">
    <section class="auth-card">

        <div class="auth-brand">
            <span class="auth-logo-wrap">
                <img src="~/images/farmacontrol-logo.png"
                     alt="FarmaControl" />
            </span>

            <h1>FarmaControl</h1>
            <p>Sistema de gestión farmacéutica</p>
        </div>

        <div class="auth-heading">
            <h2>Crear una cuenta</h2>
            <p>Completa tus datos para registrarte</p>
        </div>

        @if (TempData["Mensaje"] != null)
        {
            <div class="fc-alert fc-alert-success">
                @TempData["Mensaje"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="fc-alert fc-alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-controller="Auth"
              asp-action="Register"
              method="post"
              class="auth-form">

            <div asp-validation-summary="ModelOnly"
                 class="fc-validation-summary">
            </div>

            <!-- NOMBRE DE USUARIO -->
            <div class="fc-field">
                <label asp-for="Username">
                    Nombre de usuario
                </label>

                <input asp-for="Username"
                       class="fc-input"
                       autocomplete="username"
                       placeholder="Tu nombre de usuario" />

                <span asp-validation-for="Username"
                      class="text-danger">
                </span>
            </div>

            <!-- CORREO ELECTRONICO -->
            <div class="fc-field">
                <label asp-for="Email">
                    Correo electrónico
                </label>

                <input asp-for="Email"
                       type="email"
                       class="fc-input"
                       autocomplete="email"
                       placeholder="nombre@correo.com" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>
            </div>

            <!-- CONTRASEÑA -->
            <div class="fc-field">
                <label asp-for="Password">
                    Contraseña
                </label>

                <input asp-for="Password"
                       type="password"
                       class="fc-input"
                       autocomplete="new-password"
                       placeholder="Mínimo 8 caracteres" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn-fc-primary auth-submit">
                Crear cuenta
            </button>

        </form>

        <div class="auth-divider"></div>

        <p class="auth-register">
            ¿Ya tienes una cuenta?

            <a asp-controller="Auth"
               asp-action="Login">
                Iniciar sesión
            </a>
        </p>

    </section>

    <footer class="auth-footer">
        FarmaControl © @DateTime.Now.Year
    </footer>
</div>

<style>
    .auth-page {
        display: flex;
        width: 100%;
        flex-direction: column;
        align-items: center;
    }

    .auth-card {
        width: min(100%, 430px);
        padding: 30px 35px 26px;
        background: #FFFFFF;
        border: 1px solid #DFE7EC;
        border-radius: 13px;
        box-shadow: 0 14px 35px rgba(23,54,77,.07);
    }

    .auth-brand {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .auth-logo-wrap {
        display: grid;
        width: 58px;
        height: 58px;
        place-items: center;
        overflow: hidden;
        background: #17364D;
        border-radius: 13px;
    }

        .auth-logo-wrap img {
            width: 49px;
            height: 49px;
            object-fit: contain;
        }

    .auth-brand h1 {
        margin: 12px 0 0;
        color: #17364D;
        font-size: 23px;
        font-weight: 800;
    }

    .auth-brand p {
        margin: 3px 0 0;
        color: #8494A3;
        font-size: 11px;
    }

    .auth-heading {
        margin: 28px 0 22px;
        text-align: center;
    }

        .auth-heading h2 {
            margin: 0;
            color: #17364D;
            font-size: 18px;
            font-weight: 800;
        }

        .auth-heading p {
            margin: 6px 0 0;
            color: #8494A3;
            font-size: 11px;
        }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .fc-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

        .fc-field label {
            color: #2A4052;
            font-size: 11px;
            font-weight: 750;
        }

    .fc-input {
        display: block;
        width: 100%;
        min-height: 43px;
        padding: 9px 11px;
        color: #17364D;
        background: #FFFFFF;
        border: 1px solid #D7E1E9;
        border-radius: 6px;
        outline: 0;
        font-size: 12px;
    }

        .fc-input:focus {
            border-color: #159B8C;
            box-shadow: 0 0 0 3px rgba(21,155,140,.1);
        }

    .text-danger {
        color: #B13E45;
        font-size: 10px;
    }

    .fc-validation-summary:empty {
        display: none;
    }

    .fc-validation-summary:not(:empty) {
        padding: 10px 12px;
        color: #A53C43;
        background: #FFF0F0;
        border: 1px solid #F4D1D2;
        border-radius: 7px;
        font-size: 11px;
    }

    .fc-alert {
        padding: 10px 12px;
        margin-bottom: 13px;
        border-radius: 7px;
        font-size: 11px;
    }

    .fc-alert-success {
        color: #0A786B;
        background: #E6F5F1;
        border: 1px solid #C9EAE2;
    }

    .fc-alert-danger {
        color: #A83D42;
        background: #FFF0F0;
        border: 1px solid #F1D0D1;
    }

    .btn-fc-primary {
        display: inline-flex;
        min-height: 43px;
        align-items: center;
        justify-content: center;
        padding: 8px 15px;
        color: #FFFFFF;
        background: #159B8C;
        border: 1px solid #159B8C;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
    }

        .btn-fc-primary:hover {
            color: #FFFFFF;
            background: #117F74;
        }

    .auth-submit {
        width: 100%;
        margin-top: 3px;
    }

    .auth-divider {
        height: 1px;
        margin: 20px 0 16px;
        background: #E9EEF1;
    }

    .auth-register {
        margin: 0;
        color: #8494A3;
        text-align: center;
        font-size: 10.5px;
    }

        .auth-register a {
            color: #159B8C;
            font-weight: 700;
            text-decoration: none;
        }

            .auth-register a:hover {
                text-decoration: underline;
            }

    .auth-footer {
        margin-top: 18px;
        color: #94A2AD;
        font-size: 10px;
        text-align: center;
    }

    @@media (max-width: 575px) {
        .auth-card {
            padding: 25px 20px 22px;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
