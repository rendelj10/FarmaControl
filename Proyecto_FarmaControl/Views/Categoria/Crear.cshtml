@model Proyecto_FarmaControl.DTOs.CategoriaGuardarDto
@{
    ViewData["Title"] = "Nueva categoría";
}
<section class="fc-page fc-narrow-page">
    <header class="fc-page-heading"><div><h1>Nueva categoría</h1><p>Registra una categoría para clasificar los medicamentos.</p></div></header>
    <section class="fc-card fc-form-card">
        <h2>Información de la categoría</h2>
        <form asp-controller="Categoria" asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="fc-validation-summary"></div>
            <div class="fc-form-grid">
                <div class="fc-field"><label asp-for="Nombre">Nombre de la categoría</label><input asp-for="Nombre" class="fc-input" placeholder="Ej. Analgésicos" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
                <div class="fc-field"><label asp-for="Descripcion">Descripción</label><textarea asp-for="Descripcion" class="fc-input" rows="3" placeholder="Describe brevemente la categoría"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
            </div>
            <div class="fc-form-actions"><button type="submit" class="btn-fc-primary">Guardar categoría</button><a asp-controller="Categoria" asp-action="Index" class="btn-fc-secondary">Cancelar</a></div>
        </form>
    </section>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
