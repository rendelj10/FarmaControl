<section class="fc-page" data-fc-cash>
    <header class="fc-page-heading">
        <div><h1>Caja y turnos</h1><p>Controla la apertura, el cierre y el historial de turnos de caja.</p></div>
    </header>
    <div class="fc-cash-summary" data-fc-open-shift>
        <div class="fc-summary-card">
            <span class="fc-summary-label">Estado del turno</span>
            <strong data-fc-shift-state>Consultando...</strong>
            <small class="fc-summary-label" data-fc-shift-id>—</small>
        </div>
        <div class="fc-summary-card">
            <span class="fc-summary-label">Monto inicial</span>
            <strong data-fc-shift-opening>—</strong>
        </div>
        <div class="fc-summary-card">
            <span class="fc-summary-label">Sucursal</span>
            <strong data-fc-shift-branch>—</strong>
        </div>
        <div class="fc-summary-card">
            <span class="fc-summary-label">Apertura</span>
            <strong data-fc-shift-date>—</strong>
        </div>
    </div>

    <div class="fc-cash-grid">
        <section class="fc-card fc-cash-action-card">
            <div class="fc-form-heading"><div><h2>Abrir turno</h2><p>Registra el fondo inicial de caja.</p></div></div>
            <form data-fc-open-form>
                <div class="fc-form-grid" data-fc-open-fields></div>
                <div class="fc-form-actions"><button type="submit" class="btn-fc-primary">Abrir turno</button></div>
            </form>
        </section>
        <section class="fc-card fc-cash-action-card">
            <div class="fc-form-heading"><div><h2>Cerrar turno</h2><p>Registra el efectivo contado al finalizar.</p></div></div>
            <form data-fc-close-form>
                <div class="fc-form-grid" data-fc-close-fields></div>
                <div class="fc-form-actions"><button type="submit" class="btn-fc-primary">Cerrar turno</button></div>
            </form>
        </section>
    </div>

    <section class="fc-card fc-workspace-card">
        <div class="fc-workspace-toolbar">
            <span class="fc-section-chip">Historial de turnos</span>
            <label class="fc-search"><span class="visually-hidden">Buscar</span><span class="fc-search-icon">⌕</span><input type="search" data-fc-search placeholder="Buscar..." /></label>
        </div>
        <div class="fc-table-wrap">
            <table class="fc-table"><thead><tr data-fc-head></tr></thead><tbody data-fc-body><tr><td class="fc-table-loading" colspan="11">Cargando turnos...</td></tr></tbody></table>
        </div>
        <div class="fc-table-footer"><span data-fc-count></span><div class="fc-pagination"><button type="button" class="fc-page-button" data-fc-prev disabled>Anterior</button><span data-fc-page>1</span><button type="button" class="fc-page-button" data-fc-next disabled>Siguiente</button></div></div>
        <div class="fc-feedback" data-fc-feedback role="status" aria-live="polite"></div>
    </section>
</section>
