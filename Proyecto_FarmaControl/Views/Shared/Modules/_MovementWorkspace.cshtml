<section class="fc-card fc-reports-workspace" data-fc-movement-root>
    <div class="fc-report-header"><div><h2>Movimientos de inventario</h2><p>Consulta histórica de los movimientos registrados en SQL Server.</p></div></div>
    <form class="fc-report-filters" data-fc-report-form>
        <label>Desde <input type="date" class="fc-input" name="desde" /></label>
        <label>Hasta <input type="date" class="fc-input" name="hasta" /></label>
        <button class="btn-fc-primary" type="submit">Consultar</button>
        <button class="btn-fc-secondary" type="button" data-fc-report-export disabled>Exportar CSV</button>
    </form>
    <div class="fc-report-stats"><div><small>Registros</small><strong data-fc-report-count>—</strong></div><div><small>Unidades involucradas</small><strong data-fc-report-total>—</strong></div></div>
    <div class="fc-table-wrap"><table class="fc-table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Referencia</th><th>Origen → destino</th><th>Estado</th><th>Unidades</th></tr></thead><tbody data-fc-report-body><tr><td colspan="6" class="fc-empty-cell">Consultando movimientos...</td></tr></tbody></table></div>
    <p class="fc-muted" data-fc-report-notice></p><div class="fc-feedback" data-fc-report-feedback role="status"></div>
</section>
