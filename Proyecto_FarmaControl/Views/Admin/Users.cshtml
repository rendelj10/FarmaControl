@model List<Proyecto_FarmaControl.DTOs.UserListItemDto>
@{
    ViewData["Title"] = "Usuarios";
}
<section class="fc-page">
    <header class="fc-page-heading"><div><h1>Administración de usuarios</h1><p>Consulta las cuentas y administra sus roles y permisos.</p></div><a asp-controller="Admin" asp-action="Index" class="btn-fc-secondary">Volver a administración</a></header>
    <section class="fc-card fc-workspace-card">
        <div class="fc-workspace-toolbar"><span class="fc-section-chip">Usuarios registrados</span><span class="fc-muted">@((Model?.Count ?? 0)) usuarios</span></div>
        <div class="fc-table-wrap"><table class="fc-table"><thead><tr><th>ID</th><th>Usuario</th><th>Correo electrónico</th><th>Rol</th><th>Acciones</th></tr></thead><tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <tr><td>@user.Id</td><td class="fc-cell-strong">@user.UserName</td><td>@user.Email</td><td><span class="fc-status-pill">@user.RoleName</span></td><td><a asp-action="UserPermissions" asp-route-id="@user.Id" class="fc-action-link">Administrar permisos</a></td></tr>
            }
        }
        else { <tr><td colspan="5" class="fc-empty-cell">No hay usuarios registrados.</td></tr> }
        </tbody></table></div>
    </section>
</section>
