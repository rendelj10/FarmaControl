
@model Proyecto_FarmaControl.DTOs.LoginRequestDto

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container mt-5" style="max-width: 450px;">
    <div class="card shadow p-4">
        <h2 class="text-center mb-4">FarmaControl</h2>
        <h5 class="text-center mb-4">Iniciar sesión</h5>

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">
                @TempData["Mensaje"]
            </div>
        }

        <form asp-controller="Auth"
              asp-action="Login"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email"
                       class="form-label">Correo electrónico</label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Ingrese su correo" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password"
                       class="form-label">Contraseña</label>

                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="Ingrese su contraseña" />

                <span asp-validation-for="Password"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-primary w-100">
                Iniciar sesión
            </button>
        </form>

        <div class="text-center mt-3">
            <a asp-controller="Auth"
               asp-action="Register">
                Crear una cuenta

                <div class="text-center mt-2">
                    <a asp-controller="Auth"
                       asp-action="ForgotPassword">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                
                <div class="mt-3">
                    <form asp-controller="Auth"
                          asp-action="ResendConfirmationEmail"
                          method="post">

                        <div class="mb-2">
                            <label class="form-label">
                                ¿No has confirmado tu correo?
                            </label>

                            <input type="email"
                                   name="Email"
                                   class="form-control"
                                   value="@Model.Email"
                                   placeholder="Ingrese su correo electrónico"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-outline-primary w-100">
                            Reenviar correo de confirmación
                        </button>
                    </form>
                </div>

            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
