
@model Proyecto_FarmaControl.DTOs.CategoriaGuardarDto

@{
    ViewData["Title"] = "Nueva categoría";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Nueva categoría</h2>
        <p class="text-muted">
            Registra una nueva categoría de medicamentos.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Información de la categoría</h5>
        </div>

        <div class="card-body p-4">

            <form asp-controller="Categoria"
                  asp-action="Crear"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">

                    <label asp-for="Nombre"
                           class="form-label fw-semibold">
                        Nombre de la categoría
                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ejemplo: Analgésicos" />

                    <span asp-validation-for="Nombre"
                          class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <label asp-for="Descripcion"
                           class="form-label fw-semibold">
                        Descripción
                    </label>

                    <textarea asp-for="Descripcion"
                              class="form-control"
                              rows="4"
                              placeholder="Describe brevemente esta categoría..."></textarea>

                    <span asp-validation-for="Descripcion"
                          class="text-danger"></span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar categoría
                    </button>

                    <a asp-controller="Categoria"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
